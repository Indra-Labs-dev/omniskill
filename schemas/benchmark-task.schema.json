{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omniskill:schema:benchmark-task:v1",
  "title": "OMNISKILL benchmark task",
  "type": "object",
  "required": ["id", "category", "difficulty", "kind", "prompt", "acceptance_criteria", "evaluation", "expected_evidence", "failure_conditions", "resources"],
  "properties": {
    "id": {"type": "string", "pattern": "^(DEV|DATA|DOC|SEC|RES)-[0-9]{3}$"},
    "category": {"enum": ["dev", "data", "docs", "security", "research"]},
    "difficulty": {"enum": ["simple", "complex"]},
    "kind": {"enum": ["standard", "ambiguous", "partially_blocked", "verification_heavy", "adversarial"]},
    "prompt": {"type": "string"},
    "fixtures": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "text", "essential"],
                "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "essential": {"type": "boolean"}}}
    },
    "evaluation": {"type": "object", "required": ["method"],
                   "properties": {"method": {"enum": ["automated", "rubric", "hybrid"]}, "notes": {"type": "string"}}},
    "expected_evidence": {"type": "array", "items": {"type": "string"}},
    "failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resources": {"type": "array", "items": {"enum": ["files", "shell", "python", "node", "web", "none"]}},
    "expected_status": {"enum": ["VERIFIED", "PARTIAL", "BLOCKED", "UNVERIFIED"]}
  }
}
